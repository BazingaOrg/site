{
  "buildCommand": "PHOTOS_BUILD_CONCURRENCY=8 npm run photos:build-variants && npm run vendor:sync && bundle exec jekyll build",
  "outputDirectory": "_site",
  "installCommand": "bundle install && npm install",
  "devCommand": "bundle exec jekyll serve --host 0.0.0.0 --port $PORT",
  "framework": null,
  "headers": [
    {
      "source": "/images/photos/variants/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/photos/search.json",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }
      ]
    }
  ],
  "routes": [
    {
      "src": "/feed.xml",
      "dest": "/feed.xml",
      "headers": {
        "Content-Type": "application/rss+xml"
      }
    },
    {
      "src": "/notes.xml",
      "dest": "/notes.xml",
      "headers": {
        "Content-Type": "application/rss+xml"
      }
    },
    {
      "src": "/photos.xml",
      "dest": "/photos.xml",
      "headers": {
        "Content-Type": "application/rss+xml"
      }
    },
    {
      "src": "/stories.xml",
      "dest": "/stories.xml",
      "headers": {
        "Content-Type": "application/rss+xml"
      }
    },
    {
      "src": "/like",
      "dest": "/like.html"
    },
    {
      "src": "/posts/(.*)",
      "dest": "/posts/$1.html"
    }
  ]
}
