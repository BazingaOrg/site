# GitHub publishing
GITHUB_TOKEN=your_github_token
GITHUB_REPO=owner/repo
WRITE_ACCESS_KEY=your_write_access_key

# LLM summary generation
# Keep this pinned in production and update it manually after validating output quality.
LLM_API_KEY=your_kimi_api_key
LLM_MODEL=kimi-k2.5
LLM_BASE_URL=https://api.moonshot.cn/v1

# Cloudflare R2 → photos.json sync (npm run photos:sync-from-r2)
# Create an API token with Account → Workers R2 Storage → Read
CLOUDFLARE_ACCOUNT_ID=your_account_id
CLOUDFLARE_API_TOKEN=your_api_token
R2_BUCKET=bazinga-gallery
PHOTOS_CDN=https://img.bazinga.ink
PHOTOS_PREFIX=photos/

# Preferred (afilmory-style): npm run photos:build-variants
# Downloads originals from PHOTOS_CDN (public) and writes WebP under images/photos/variants/
# No R2 write permission required. Wired into Vercel buildCommand.
#
# Optional fallback download via API if CDN is blocked:
# CLOUDFLARE_API_TOKEN with R2 Read is enough.
#
# Legacy optional upload-to-R2 path (photos:build-variants-from-r2) needs write:
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# PHOTOS_BUILD_CONCURRENCY=2
